{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@shs-ui/components": ["packages/components/src/index.ts"],
      "@shs-ui/utils": ["packages/utils/src/index.ts"],
      "@shs-ui/icons": ["packages/icons/src/index.ts"]
    },
    "types": ["vitest/globals", "node"]
  },
  "include": ["packages/**/*", "docs/**/*", "playground/**/*"],
  "exclude": ["node_modules", "dist", "**/dist"]
}
