{
  "name": "@qqshs0/s_ui",
  "version": "0.0.1",
  "description": "基于 Vue 3 的企业级前端 UI 框架（s_ui 单一包：组件 + 主题 + 工具函数 + 图标）",
  "type": "module",
  "main": "dist/index.umd.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./style": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "keywords": [
    "s_ui",
    "vue",
    "ui",
    "components",
    "framework"
  ],
  "license": "MIT",
  "scripts": {
    "build": "vite build"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@shs-ui/components": "workspace:*",
    "@shs-ui/icons": "workspace:*",
    "@shs-ui/theme": "workspace:*",
    "@shs-ui/utils": "workspace:*",
    "@vitejs/plugin-vue": "^5.0.5",
    "sass": "^1.77.6",
    "vite": "^5.3.3",
    "vite-plugin-dts": "^4.0.0",
    "vue": "^3.4.31"
  }
}
