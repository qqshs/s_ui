{
  "name": "shs-ui",
  "version": "0.0.0",
  "private": true,
  "description": "shs_ui —— 基于 Vue 3 的企业级前端 UI 框架（monorepo）",
  "type": "module",
  "packageManager": "pnpm@9.5.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "pnpm -C playground dev",
    "build": "pnpm -r --filter \"./packages/**\" build",
    "docs:dev": "pnpm -C docs dev",
    "docs:build": "pnpm -C docs build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "clean": "rimraf node_modules packages/*/dist packages/*/node_modules playground/dist docs/.vitepress/dist",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.5",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@eslint/js": "^9.6.0",
    "@types/node": "^20.14.0",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vitest/coverage-v8": "^1.6.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.6.0",
    "eslint-plugin-vue": "^9.27.0",
    "husky": "^9.0.11",
    "jsdom": "^24.1.0",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.2",
    "rimraf": "^5.0.7",
    "sass": "^1.77.6",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.3.3",
    "vitest": "^1.6.0",
    "vue": "^3.4.31",
    "vue-tsc": "^2.0.26"
  }
}
